<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>com.processpuzzle</groupId>
  <artifactId>processpuzzle-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>ProcessPuzzle :: Backend :: Parent</name>
  <description>ProcessPuzzle platform libraries</description>
  <url>https://github.com/ZsZs/processpuzzle</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>zsuffazs</id>
      <name>Zsolt Zsuffa</name>
      <email>zsolt.zsuffa@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/ZsZs/processpuzzle.git</connection>
    <developerConnection>scm:git:ssh://github.com/ZsZs/processpuzzle.git</developerConnection>
    <url>https://github.com/ZsZs/processpuzzle</url>
  </scm>

  <modules>
    <module>apps/processpuzzle-testbed-backend</module>
    <module>libs/java-shared/api-contracts</module>
    <module>libs/java-shared/base-app-backend</module>
    <module>libs/java-shared/base-document-backend</module>
    <module>libs/java-shared/base-entity-backend</module>
    <module>libs/java-shared/base-workflow-backend</module>
    <module>libs/java-shared/base-rule-backend</module>
    <module>libs/java-shared/base-state-backend</module>
    <module>libs/java-shared/base-widget-backend</module>
    <module>libs/java-shared/org-admin-backend</module>
    <module>libs/java-shared/processpuzzle-store</module>
    <module>libs/java-shared/processpuzzle-core</module>
  </modules>

  <properties>
    <!-- The parent's own version. Maven only honours `revision`, `sha1` and `changelist` as
         version placeholders, so this property (not <processpuzzle-parent.version>) is what
         <version>${revision}</version> above and all 12 child <parent> refs resolve. Same
         convention as the per-lib properties below: it holds the CURRENT PUBLISHED version,
         no SNAPSHOT between releases, so the next `patch` release publishes 1.0.5.
         tools/scripts/release-java-lib.mjs bumps it; flatten-maven-plugin
         (flattenMode=resolveCiFriendliesOnly, declared root-only) resolves the reference at
         publish time so the deployed pom carries a literal version. -->
    <revision>1.0.6</revision>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <minio.version>8.6.0</minio.version>
    <okhttp.version>4.12.0</okhttp.version>
    <rsql-parser.version>2.1.0</rsql-parser.version>
    <!-- Spring Boot's BOM does not manage Spring Modulith, so spring-modulith-bom is imported
         below. 2.1.0 is the line built against Spring Boot 4.1. -->
    <spring-modulith.version>2.1.0</spring-modulith.version>
    <!-- Default so surefire's @{argLine} resolves in modules that do NOT run the JaCoCo
         agent (e.g. app modules without the jacoco plugin). jacoco:prepare-agent overrides
         this property with the -javaagent argument in modules that do. Without this default,
         @{argLine} is passed literally and the forked JVM fails with "could not open {argLine}". -->
    <argLine/>
    <!-- Locations of the shared tool configurations. Indirected through properties because
         ${maven.multiModuleProjectDirectory} resolves against the REACTOR root: a downstream
         repository that inherits this parent (e.g. processpuzzle-biz) would look for the files
         under its own root and fail. Such a repository overrides these two properties, one
         line each, instead of re-declaring checkstyle and spotless. -->
    <pp.checkstyle.config>${maven.multiModuleProjectDirectory}/tools/checkstyle.xml</pp.checkstyle.config>
    <pp.formatter.config>${maven.multiModuleProjectDirectory}/tools/eclipse-formatter.xml</pp.formatter.config>
    <!-- Per-lib versions. Single source of truth: each child pom references the matching
         property via <version>${<lib>.version}</version>, and root <dependencyManagement>
         pins sibling deps to the same property. Property therefore always reflects the
         CURRENT PUBLISHED version, no SNAPSHOT between releases.
         tools/scripts/release-java-lib.mjs bumps to the next version (per the increment
         flag) on release; flatten-maven-plugin resolves the reference at publish time. -->
    <api-contracts.version>1.1.2</api-contracts.version>
    <base-app-backend.version>1.1.1</base-app-backend.version>
    <base-document-backend.version>0.1.0</base-document-backend.version>
    <base-entity-backend.version>0.1.0</base-entity-backend.version>
    <base-rule-backend.version>1.1.0</base-rule-backend.version>
    <base-state-backend.version>1.0.5</base-state-backend.version>
    <base-workflow-backend.version>1.0.5</base-workflow-backend.version>
    <base-widget-backend.version>0.1.0</base-widget-backend.version>
    <org-admin-backend.version>0.1.0</org-admin-backend.version>
    <processpuzzle-core.version>1.1.1</processpuzzle-core.version>
    <processpuzzle-store.version>1.1.2</processpuzzle-store.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Modulith BOM — every library declares spring-modulith-api without a
           version so the whole workspace moves in lockstep. -->
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Module dependencies. groupId is the LITERAL com.processpuzzle, not
           ${project.groupId}: flattenMode=resolveCiFriendliesOnly resolves only ${revision}
           in <version> and leaves every other expression in place, so a ${project.groupId}
           here would re-resolve to the groupId of whichever downstream project inherits
           this parent and none of these pins would apply. -->
      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>processpuzzle-core</artifactId>
        <version>${processpuzzle-core.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>processpuzzle-store</artifactId>
        <version>${processpuzzle-store.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-document-backend</artifactId>
        <version>${base-document-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-entity-backend</artifactId>
        <version>${base-entity-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-rule-backend</artifactId>
        <version>${base-rule-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-state-backend</artifactId>
        <version>${base-state-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-workflow-backend</artifactId>
        <version>${base-workflow-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-app-backend</artifactId>
        <version>${base-app-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>base-widget-backend</artifactId>
        <version>${base-widget-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>org-admin-backend</artifactId>
        <version>${org-admin-backend.version}</version>
      </dependency>

      <dependency>
        <groupId>com.processpuzzle</groupId>
        <artifactId>processpuzzle-api</artifactId>
        <version>${api-contracts.version}</version>
      </dependency>

      <!-- Spring Boot dependencies -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>3.0.3</version>
      </dependency>

      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
        <version>0.2.6</version>
      </dependency>

      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>

      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp</artifactId>
        <version>${okhttp.version}</version>
      </dependency>

      <dependency>
        <groupId>cz.jirutka.rsql</groupId>
        <artifactId>rsql-parser</artifactId>
        <version>${rsql-parser.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Checkstyle plugin -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- checkstyle rules -->
            <configLocation>${pp.checkstyle.config}</configLocation>
            <!-- Silence per-violation console noise; errors still fail the build
                 (failsOnError=true) and full details are written to the XML report. -->
            <consoleOutput>false</consoleOutput>
            <logViolationsToConsole>false</logViolationsToConsole>
            <violationSeverity>error</violationSeverity>
            <!-- Generate XML report -->
            <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
            <outputFileFormat>xml</outputFileFormat>
            <failsOnError>true</failsOnError>
            <linkXRef>false</linkXRef>
          </configuration>
          <executions>
            <execution>
              <id>validate</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Compiler plugin for Java compilation -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <!-- Sources JAR — required by Maven Central -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Javadoc JAR — required by Maven Central -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <doclint>none</doclint>
            <quiet>true</quiet>
            <failOnWarnings>false</failOnWarnings>
            <detectJavaApiLink>false</detectJavaApiLink>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Jacoco MAVEN plugin -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.14</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <!-- Bound to `test` (not `verify`) so the XML report is produced by
                 `mvn test`, which is what the Nx test target and CI run. -->
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Jacoco to LCOV conversion plugin -->
        <plugin>
          <groupId>com.github.pknidhu</groupId>
          <artifactId>jacoco-to-lcov-maven-plugin</artifactId>
          <version>1.0.1</version>
          <executions>
            <execution>
              <id>convert-to-lcov</id>
              <phase>verify</phase>
              <goals>
                <goal>jacoco-to-lcov</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- GPG signing — required by Maven Central -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.7</version>
          <configuration>
            <keyname>zsolt.zsuffa@gmail.com</keyname>
            <passphraseServerId>gpg</passphraseServerId>
          </configuration>
          <executions>
            <execution>
              <id>sign-artifacts</id>
              <phase>deploy</phase>
              <goals>
                <goal>sign</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Central Publishing Plugin — replaces legacy OSSRH -->
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.8.0</version>
          <extensions>true</extensions>
          <configuration>
            <!-- Must match <server><id>central</id> in settings.xml. -->
            <publishingServerId>central</publishingServerId>
            <autoPublish>true</autoPublish>
            <!-- `validated`, not `published`: the goal returns once Central has accepted and
                 validated the bundle, and autoPublish then publishes it. `published` blocks
                 until the artifact has fully propagated, which routinely takes longer than a
                 job's timeout — it hung the first parent release for 28 minutes until the
                 30-minute limit killed it, long after the upload had succeeded. Every lib
                 already states `validated` explicitly, so this only changes the default the
                 root itself inherits. -->
            <waitUntil>validated</waitUntil>
          </configuration>
        </plugin>

        <!-- Versions plugin — used by tools/scripts/release-java-lib.mjs to bump
             per-lib versions during release. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.19.1</version>
        </plugin>

        <!-- Spotless: applies the Eclipse formatter (tools/eclipse-formatter.xml)
             project-wide. Run `mvn spotless:apply` to reformat, `mvn spotless:check`
             to verify. Not bound to a phase yet — enable the `validate` binding once
             the whole codebase has been reformatted. -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.44.5</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <eclipse>
                <file>${pp.formatter.config}</file>
              </eclipse>
            </java>
          </configuration>
        </plugin>

        <!-- Dependency plugin for copying dependencies -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>

        <!-- Antrun plugin for copying build artifacts to dist -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>

        <!-- Flatten POM for Central deployment. Managed here rather than declared in
             <build><plugins>, because plugin CONFIGURATION is inherited and the root needs a
             different flattenMode than its children: the children publish a minimal
             consumer-facing pom (ossrh), whereas the root IS a parent pom and must keep its
             <properties>, <dependencyManagement> and <pluginManagement>. The root therefore
             re-declares this plugin below with <inherited>false</inherited> and
             flattenMode=resolveCiFriendliesOnly; every publishable child declares a bare
             entry in its own <build><plugins> and inherits the ossrh config from here. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.6.0</version>
          <configuration>
            <updatePomFile>true</updatePomFile>
            <flattenMode>ossrh</flattenMode>
          </configuration>
          <executions>
            <execution>
              <id>flatten</id>
              <phase>process-resources</phase>
              <goals>
                <goal>flatten</goal>
              </goals>
            </execution>
            <execution>
              <id>flatten-clean</id>
              <phase>clean</phase>
              <goals>
                <goal>clean</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Copy dependencies to target/dependencies for Sonar analysis -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>compile</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependencies</outputDirectory>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>false</overWriteSnapshots>
              <overWriteIfNewer>true</overWriteIfNewer>
              <excludeGroupIds>com.processpuzzle</excludeGroupIds>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire: activate the "unit-test" Spring profile for every module's unit tests,
           and silence JDK 25 warnings from dynamic agents (Mockito/ByteBuddy) and native
           access (Truffle in the RSQL engine). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>unit-test</spring.profiles.active>
          </systemPropertyVariables>
          <!-- @{argLine} preserves the JaCoCo agent injected by jacoco:prepare-agent;
               a bare value would replace it and produce zero coverage. -->
          <argLine>@{argLine} -XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>

      <!-- Flatten this pom for Central deployment. Root-only (<inherited>false</inherited>):
           children get the managed ossrh configuration instead, by declaring a bare
           flatten-maven-plugin entry of their own.
           resolveCiFriendliesOnly resolves ${revision} in <version> and KEEPS everything a
           parent pom has to publish — properties, dependencyManagement, pluginManagement,
           build. `ossrh` would strip all of it and deploy an empty shell that inherits
           nothing. The published pom keeps <modules>, which is harmless: <modules> is not an
           inherited element, so an inheriting repository declares its own and never builds
           this repository's. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
      </plugin>

      <!-- GPG signing — required by Maven Central. Root-only: the app module must not
           become publishable by inheriting it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <inherited>false</inherited>
      </plugin>

      <!-- Central Publishing Plugin — lets `mvn -N deploy` publish this parent pom itself.
           Root-only, for the same reason as the GPG plugin above. Sources/javadoc jars are
           not required for `pom` packaging, so those plugins stay unbound here. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <inherited>false</inherited>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
