        "colorScheme": "light"
      },
      "layout": {
        "preset": "sidenav-left",
        "sidenavMode": "side",
        "sidenavCollapsible": true,
        "sidenavOpenByDefault": true,
        "contentMaxWidth": "1280px"
      },
      "regions": [
        {
          "type": "header"
        },
        {
          "type": "sidenav",
          "navItems": [
            {
              "id": "nav-orders",
              "label": "Orders",
              "translocoId": "demo.nav.orders",
              "icon": "receipt_long",
              "children": [
                {
                  "id": "nav-order-list",
                  "label": "All orders",
                  "translocoId": "demo.nav.orderList",
                  "icon": "list_alt",
                  "pageId": "order-list"
                },
                {
                  "id": "nav-order-entry",
                  "label": "New order",
                  "translocoId": "demo.nav.orderEntry",
                  "icon": "add_circle",
                  "pageId": "order-entry"
                }
              ]
            },
            {
              "id": "nav-order-lines",
