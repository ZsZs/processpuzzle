  "processpuzzle-testbed-tools": [
    {
      "id": "automated-check-tool",
      "name": "Automated Check Tool",
      "description": "Stand-in for the inventory and document service the testbed's order fulfillment steps call. Referenced by `automated-check-tool` in default-workflows/processpuzzle-testbed-workflows.yaml.",
      "baseUrl": "https://checks.example.com",
      "auth": {
        "type": "BEARER_TOKEN",
        "secretRef": "AUTOMATED_CHECK_TOKEN"
      },
      "operations": [
        {
          "id": "inventory-check",
          "method": "POST",
          "path": "/v1/inventory/check",
          "description": "Verifies that every line item of an order is available in stock.",
          "payloadTemplate": "{ \"orderId\": \"${entityId}\" }",
          "expectedStatusCodes": [200]
        },
        {
          "id": "generate-doc",
          "method": "POST",
          "path": "/v1/documents",
          "description": "Produces the delivery confirmation and final invoice.",
          "expectedStatusCodes": [200, 201]
        }
      ],
      "version": 1,
      "createdAt": "2026-08-01T09:00:00Z"
    }
  ],
