{
  "name": "firebase-functions",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/firebase/functions",
  "tags": ["scope:tools", "type:cloud-functions"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/package-lock.json"],
      "options": {
        "command": "npm --prefix tools/firebase/functions install --no-audit --no-fund"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "cache": true,
      "outputs": ["{projectRoot}/lib"],
      "options": {
        "command": "npm --prefix tools/firebase/functions run build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "cache": true,
      "options": {
        "command": "npm --prefix tools/firebase/functions run lint"
      },
      "configurations": {
        "ci": {},
        "dev": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "cache": true,
      "outputs": ["{projectRoot}/reports/coverage"],
      "options": {
        "parallel": false,
        "commands": ["npm --prefix tools/firebase/functions run typecheck", "npx vitest run --config tools/firebase/functions/vitest.config.ts"]
      },
      "configurations": {
        "ci": {}
      }
    }
  }
}
