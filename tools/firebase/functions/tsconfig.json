{
  "compilerOptions": {
    "allowJs": true,
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "./org-scope.js",
    "./package.json"
  ],
  "//": "Specs are ESM (top-level await) and must never reach the deployed bundle; tsconfig.spec.json type-checks them instead.",
  "exclude": [
    "node_modules",
    "lib",
    "**/*.spec.ts",
    "src/**/test-support.ts",
    "vitest.config.ts"
  ]
}
