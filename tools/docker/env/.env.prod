# ── prod ────────────────────────────────────────────────────────────────────────────────────────
#
# NON-SECRET values only — see the header of .env.stage, which applies unchanged: the credentials
# come from the GitHub Environment `PROD`, this file is the source of truth that has to be entered
# once into the Coolify resource, and `docker compose --env-file … config` is expected to fail on the
# three `:?`-guarded credentials until they are exported.
#
# This file replaces the infrastructure half of the deleted docker-compose-prod.yaml, which had
# drifted from CI: no MinIO service at all, no pgweb, and its own copy of postgres/keycloak. The
# application half becomes one Coolify Application resource per app image
# (docs/build-deploy-strategy.md §4).

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
# `:prod` is re-tagged from the `sha-<commit>` already verified on stage — promoted, not rebuilt, so
# the exact bytes tested on stage are what reach production (strategy §9).
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=prod
PP_PGWEB_VERSION=0.17.0

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle-prod

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# Loopback only. The reverse proxy reaches these over the compose network; a public bind on any of
# them would expose the database, the object store or the mock server directly.
PP_POSTGRES_PUBLISH=127.0.0.1:5432:5432
PP_KEYCLOAK_PUBLISH=127.0.0.1:7070:8080
PP_MINIO_API_PUBLISH=127.0.0.1:7000:9000
PP_MINIO_CONSOLE_PUBLISH=127.0.0.1:7001:9001
PP_PGWEB_PUBLISH=127.0.0.1:8082:8081
PP_JSON_SERVER_PUBLISH=127.0.0.1:3000:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PGWEB_DATABASE=processpuzzle_testbed

# ── Keycloak ────────────────────────────────────────────────────────────────────────────────────
# Its own hostname at the root; see .env.stage for why there is no /auth prefix.
KC_HOSTNAME=https://auth.processpuzzle.com
KC_HOSTNAME_STRICT=true
KC_INTERNAL_URL=http://keycloak:8080

# ── MinIO ───────────────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_SERVICE_USER=springboot
