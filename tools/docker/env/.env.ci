# ── ci ──────────────────────────────────────────────────────────────────────────────────────────
#
# The local-development and CI environment. Mirrors the
# apps/processpuzzle-testbed-e2e/env/.env.<environment> convention: one file per environment, holding
# the values that differ, so that one compose definition serves all three.
#
# Unlike .env.stage and .env.prod this file DOES hold credentials — the same demo values that have
# always been in git, so `npm run stack-up` works with zero setup. Nothing here reaches a deployed
# environment.
#
#   docker compose -p processpuzzle --env-file tools/docker/env/.env.ci \
#     -f tools/docker/docker-compose-infrastructure.yaml \
#     -f tools/docker/docker-compose-apps.yaml up -d --wait

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
# `latest` is what the local build path tags, and what deploy-infrastructure.yml also pushes on
# develop, so `npm run stack-pull` finds something. The infra packages must be public on GHCR, or
# `docker login ghcr.io` first; `npm run stack-up-build` needs neither.
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=latest
PP_PGWEB_VERSION=0.17.0

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# The Firestore emulator owns host 8081, which is why pgweb takes 8082 while still listening on 8081
# inside the container.
PP_POSTGRES_PUBLISH=5432:5432
PP_KEYCLOAK_PUBLISH=7070:8080
PP_MINIO_API_PUBLISH=7000:9000
PP_MINIO_CONSOLE_PUBLISH=7001:9001
PP_PGWEB_PUBLISH=8082:8081
PP_JSON_SERVER_PUBLISH=3000:3000
PP_TESTBED_FRONTEND_PUBLISH=9090:80
PP_TESTBED_BACKEND_PUBLISH=8080:8080

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
POSTGRES_PASSWORD=password123
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PROCESSPUZZLE_DB_PASSWORD=processpuzzle
PGWEB_DATABASE=processpuzzle_testbed

# ── Keycloak ────────────────────────────────────────────────────────────────────────────────────
# KC_HOSTNAME is the browser-facing origin: Keycloak builds the issuer and every endpoint of its
# discovery document from it. There is deliberately no KC_HTTP_RELATIVE_PATH: it is a Keycloak
# BUILD-time option, and an `--optimized` start exits 2 when it is supplied at run time — see the
# comment on the keycloak service. Keycloak is served at the root of its origin in every environment.
KC_HOSTNAME=http://localhost:7070
KC_HOSTNAME_STRICT=false
KC_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
PLATFORM_ADMIN_CLIENT_SECRET=platform-admin-secret

# ── MinIO ───────────────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SERVICE_USER=springboot
MINIO_SERVICE_PASSWORD=springboot123

# ── Applications (docker-compose-apps.yaml only) ────────────────────────────────────────────────
PIPELINE_STAGE=ci
# Not optional even though nothing in the `ci` stack talks to Firebase: the testbed's entrypoint
# fails fast on an unset one, so the container exits before nginx starts. Any non-empty value will
# do, and an exported FIREBASE_API_KEY overrides this — the shell wins over --env-file.
FIREBASE_API_KEY=local-placeholder
SPRING_PROFILES_ACTIVE=ci
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processpuzzle_testbed
PROCESSPUZZLE_SECURITY_STACK_REALM=processpuzzle-testbed
MINIO_BUCKET_PREFIX=processpuzzle-testbed
MINIO_ENDPOINT=http://minio:9000
APP_CORS_ALLOWED_ORIGINS=http://localhost:9090,http://localhost:4200
# Both URLs, because here they genuinely differ — see the comment on the service.
PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL=http://localhost:7070
PROCESSPUZZLE_SECURITY_JWKS_BASE_URL=http://keycloak:8080
