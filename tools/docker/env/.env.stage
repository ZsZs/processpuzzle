# ── stage ───────────────────────────────────────────────────────────────────────────────────────
#
# NON-SECRET values only. Every credential is deliberately absent: they come from the GitHub
# Environment `STAGE` (see .env.example for the list). The `:?` guards in
# docker-compose-infrastructure.yaml make an omission fail at `up`, which is why
#
#   docker compose --env-file tools/docker/env/.env.stage -f …infrastructure.yaml config
#
# is EXPECTED to fail naming POSTGRES_PASSWORD, KEYCLOAK_ADMIN_USERNAME and KEYCLOAK_ADMIN_PASSWORD.
#
# HOW THIS FILE REACHES THE DEPLOYMENT. A Coolify Docker Compose resource reads the compose file from
# git and interpolates it with the RESOURCE'S OWN environment variables — `--env-file` is not in that
# path. So this file is the documented source of truth that has to be entered once into the Coolify
# resource (credentials marked as secret there). `--env-file` is what `ci` and local development use.
# Because every variable in the compose file carries a `${VAR:-<ci default>}` default, a variable
# missed in Coolify degrades to the CI value rather than to an empty string — check the rendered
# `docker compose config` on the first deploy.

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
# The moving tag the resource watches. deploy-infrastructure.yml pushes it, and the resource needs
# Coolify's "pull latest images and restart" option enabled — `force=true` restarts without always
# re-pulling (coollabsio/coolify#5318).
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=stage
PP_PGWEB_VERSION=0.17.0

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle-stage

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# Bound to loopback: the reverse proxy in front of the stack reaches these containers over the
# compose network, so nothing needs a public bind. Loopback still leaves them reachable through an
# SSH tunnel for inspection.
PP_POSTGRES_PUBLISH=127.0.0.1:5432:5432
PP_KEYCLOAK_PUBLISH=127.0.0.1:7070:8080
PP_MINIO_API_PUBLISH=127.0.0.1:7000:9000
PP_MINIO_CONSOLE_PUBLISH=127.0.0.1:7001:9001
PP_PGWEB_PUBLISH=127.0.0.1:8082:8081
PP_JSON_SERVER_PUBLISH=127.0.0.1:3000:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD and PROCESSPUZZLE_DB_PASSWORD are secrets — not here.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PGWEB_DATABASE=processpuzzle_testbed

# ── Keycloak ────────────────────────────────────────────────────────────────────────────────────
# Its OWN hostname, at the root — not a /auth prefix of a shared origin. KC_HTTP_RELATIVE_PATH is a
# Keycloak build-time option and an `--optimized` start exits 2 when it is given at run time, so a
# path prefix would mean an environment-specific image; one Coolify resource, one domain instead.
# KC_HOSTNAME must match the DNS name the browser is redirected to — `processpuzzle.com` subdomains
# are still open in docs/application-stacks.md, so confirm this before the first deploy.
KC_HOSTNAME=https://auth.stage.processpuzzle.com
KC_HOSTNAME_STRICT=true
KC_INTERNAL_URL=http://keycloak:8080

# ── MinIO ───────────────────────────────────────────────────────────────────────────────────────
# MINIO_ROOT_PASSWORD and MINIO_SERVICE_PASSWORD are secrets — not here.
MINIO_ROOT_USER=minioadmin
MINIO_SERVICE_USER=springboot
