# ── stage ───────────────────────────────────────────────────────────────────────────────────────
#
# NON-SECRET values only. Every credential is deliberately absent: they come from the GitHub
# Environment `STAGE` (see .env.example for the list). The `:?` guards in
# docker-compose-infrastructure.yaml make an omission fail at `up`, which is why
#
#   docker compose --env-file tools/docker/env/.env.stage -f …infrastructure.yaml config
#
# is EXPECTED to fail naming POSTGRES_PASSWORD, KEYCLOAK_ADMIN_USERNAME and KEYCLOAK_ADMIN_PASSWORD.
#
# HOW THIS FILE REACHES THE DEPLOYMENT. A Coolify Docker Compose resource reads the compose file from
# git and interpolates it with the RESOURCE'S OWN environment variables — `--env-file` is not in that
# path. So this file is the documented source of truth that has to be entered once into the Coolify
# resource (credentials marked as secret there). `--env-file` is what `ci` and local development use.
# Because every variable in the compose file carries a `${VAR:-<ci default>}` default, a variable
# missed in Coolify degrades to the CI value rather than to an empty string — check the rendered
# `docker compose config` on the first deploy.
#
# TWO RESOURCES read this one file: the infrastructure resource
# (docker-compose-infrastructure.yaml) and the testbed stack's application resource
# (docker-compose-apps.yaml). Enter the sections each needs into the corresponding resource; entering
# all of it into both is harmless and is what keeps the two from drifting.
#
# HOSTNAMES ARE `.de`, matching the Coolify control plane: testbed.stage.processpuzzle.de,
# api.stage.processpuzzle.de, auth.stage.processpuzzle.de. `.env.prod` still names `.com` hosts and
# docs/application-stacks.md:30 names `testbed.processpuzzle.com`, so the split is real and
# deliberately not resolved here — prod is not guessed from stage.

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
# The moving tag the resource watches. deploy-infrastructure.yml pushes it, and the resource needs
# Coolify's "pull latest images and restart" option enabled — `force=true` restarts without always
# re-pulling (coollabsio/coolify#5318).
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=stage
PP_PGWEB_VERSION=0.17.0

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle-stage

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# Bound to loopback: the reverse proxy in front of the stack reaches these containers over the
# compose network, so nothing needs a public bind. Loopback still leaves them reachable through an
# SSH tunnel for inspection.
PP_POSTGRES_PUBLISH=127.0.0.1:5432:5432
PP_KEYCLOAK_PUBLISH=127.0.0.1:7070:8080
PP_MINIO_API_PUBLISH=127.0.0.1:7000:9000
PP_MINIO_CONSOLE_PUBLISH=127.0.0.1:7001:9001
PP_PGWEB_PUBLISH=127.0.0.1:8082:8081
PP_JSON_SERVER_PUBLISH=127.0.0.1:3000:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD and PROCESSPUZZLE_DB_PASSWORD are secrets — not here.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PGWEB_DATABASE=processpuzzle_testbed

# ── Keycloak ────────────────────────────────────────────────────────────────────────────────────
# Its OWN hostname, at the root — not a /auth prefix of a shared origin. KC_HTTP_RELATIVE_PATH is a
# Keycloak build-time option and an `--optimized` start exits 2 when it is given at run time, so a
# path prefix would mean an environment-specific image; one Coolify resource, one domain instead.
#
# KC_HOSTNAME is the DNS name the BROWSER is redirected to, and Keycloak builds the issuer of every
# token from it. Three things have to agree on this string, character for character:
# PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL below, `AUTHENTICATION_SERVICE_ROOT` /
# `AUTH_SERVICE_CONFIG.authServerUrl` in config.stage.json, and the domain set on the Keycloak
# service in Coolify. A mismatch is a 401 on every authenticated request, with nothing in the browser
# to explain it.
KC_HOSTNAME=https://auth.stage.processpuzzle.de
KC_HOSTNAME_STRICT=true
KC_INTERNAL_URL=http://keycloak:8080

# ── MinIO ───────────────────────────────────────────────────────────────────────────────────────
# MINIO_ROOT_PASSWORD and MINIO_SERVICE_PASSWORD are secrets — not here.
MINIO_ROOT_USER=minioadmin
MINIO_SERVICE_USER=springboot

# ── Applications (docker-compose-apps.yaml only) ────────────────────────────────────────────────
# Everything below belongs to the testbed stack's application resource, not the infrastructure one.
# It is here rather than in a file of its own because both resources deploy the same environment and
# one source of truth per environment is the point of this directory.
#
# The two published ports are loopback-bound like the infrastructure ones: Coolify's proxy reaches
# both containers over the compose network, so neither needs a public bind, and an SSH tunnel still
# reaches them for inspection.
PP_TESTBED_FRONTEND_PUBLISH=127.0.0.1:9090:80
PP_TESTBED_BACKEND_PUBLISH=127.0.0.1:8080:8080

# Selects run-time-conf/config.stage.json out of the bundle the frontend image baked, and the
# `on-profile: stage | prod` block of the backend's application.yaml. Everything else about the two
# images is environment-neutral, which is what lets one `sha-<commit>` be promoted (strategy §9).
PIPELINE_STAGE=stage
SPRING_PROFILES_ACTIVE=stage
FIREBASE_API_KEY=

# The testbed stack's own database, realm and bucket prefix — one string, mechanically derived, see
# docs/application-stacks.md. PostgreSQL, MinIO and Keycloak's admin API are all reached over the
# compose network, so these are service names and not the loopback-published ports.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processpuzzle_testbed
PROCESSPUZZLE_SECURITY_STACK_REALM=processpuzzle-testbed
MINIO_BUCKET_PREFIX=processpuzzle-testbed
MINIO_ENDPOINT=http://minio:9000

# ── The two that CANNOT take a CI default ───────────────────────────────────────────────────────
# Every other variable in docker-compose-apps.yaml degrades safely to its CI value. These two do
# not, and both fail silently:
#
# - CORS is load-bearing here because nginx does NOT proxy to the backend. The browser calls
#   APP_SERVICE_ROOT (api.stage…) from the frontend's origin (testbed.stage…), cross-origin, so an
#   origin missing from this list arrives as HTTP status 0 with no explanation. Left at the CI
#   default it would allow localhost and nothing else.
# - The issuer must equal KC_HOSTNAME above. Left at the CI default (http://localhost:7070) the
#   backend rejects every token the real Keycloak minted.
#
# JWKS stays on the compose network and therefore keeps its CI default: the browser-facing origin
# does not resolve inside the container, and reading the signing keys from the issuer URL is what
# made every authenticated request answer 500 — see TenantAuthenticationManagerResolver.
APP_CORS_ALLOWED_ORIGINS=https://testbed.stage.processpuzzle.de
PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL=https://auth.stage.processpuzzle.de
