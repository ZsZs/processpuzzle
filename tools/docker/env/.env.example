# ── The secrets, and where each is consumed ─────────────────────────────────────────────────────
#
# .env.ci, .env.stage and .env.prod are committed and hold non-secret values. This file documents the
# variables that are NOT committed for stage/prod. They live in the GitHub Environments `STAGE` and
# `PROD` (used by .github/workflows/deploy-infrastructure.yml) and, because a Coolify Docker Compose
# resource interpolates the compose file with its own environment rather than with `--env-file`, they
# also have to be entered into the Coolify resource and marked as secret there.
#
# Copy this file to .env.local (gitignored) to run the stage/prod topology locally:
#   docker compose --env-file tools/docker/env/.env.stage --env-file tools/docker/env/.env.local \
#     -f tools/docker/docker-compose-infrastructure.yaml config
#
# `ci` needs none of this: .env.ci carries the demo credentials.

# ── Deployment ──────────────────────────────────────────────────────────────────────────────────
# The full webhook URL Coolify prints on the resource's Webhook page, `?uuid=<resource-uuid>` and
# all. Taking the whole URL from a secret is what keeps .github/actions/coolify-deploy
# platform-agnostic. Consumed by: deploy-infrastructure.yml → coolify-deploy.
COOLIFY_WEBHOOK=
# Coolify API token, `deploy` permission only.
COOLIFY_TOKEN=

# ── Credentials ─────────────────────────────────────────────────────────────────────────────────
# Keycloak's own database role. Consumed by: postgres (POSTGRES_PASSWORD) and keycloak
# (KC_DB_PASSWORD) — one role, so one value. `:?`-guarded: `up` fails without it.
POSTGRES_PASSWORD=
# The application role that 10-init-db.sh creates and that owns every stack's database. Consumed by:
# postgres (10-init-db.sh), pgweb (PGWEB_DATABASE_URL) and each backend
# (SPRING_DATASOURCE_PASSWORD).
PROCESSPUZZLE_DB_PASSWORD=
# Keycloak's bootstrap admin, and the account keycloak-init authenticates with. Both `:?`-guarded.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# MinIO root. Consumed by: minio, and by init-minio.sh to create the service account below.
MINIO_ROOT_PASSWORD=
# The Spring service account init-minio.sh creates. Consumed by: minio and each backend
# (MINIO_SECRET_KEY).
MINIO_SERVICE_PASSWORD=
# The master-realm service account keycloak-init provisions, used by a backend to manage realms and
# users. Consumed by: keycloak-init and each backend (KEYCLOAK_ADMIN_CLIENT_SECRET). Without it the
# identity ports fall back to their no-ops and every other feature still works.
PLATFORM_ADMIN_CLIENT_SECRET=

# ── Local development only ──────────────────────────────────────────────────────────────────────
# Not optional even though nothing in the `ci` stack talks to Firebase: the testbed's entrypoint
# fails fast on an unset one, so the container exits before nginx starts. Any non-empty value will do
# locally.
FIREBASE_API_KEY=
