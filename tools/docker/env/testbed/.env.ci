# ── testbed · ci ────────────────────────────────────────────────────────────────────────────────
#
# The processpuzzle-testbed application stack — its frontend and its backend — in the
# local-development and CI environment. One Coolify Docker Compose resource reads
# docker-compose-apps.yaml, and this is its environment.
#
# Unlike stage/prod this file DOES hold credentials — the same demo values that have always been in
# git, so `npm run stack-up` works with zero setup. Nothing here reaches a deployed environment.
#
# Combined runs pass both files; repeated `--env-file` is additive:
#
#   docker compose -p processpuzzle \
#     --env-file tools/docker/env/infrastructure/.env.ci \
#     --env-file tools/docker/env/testbed/.env.ci \
#     -f tools/docker/docker-compose-infrastructure.yaml \
#     -f tools/docker/docker-compose-apps.yaml up -d --wait
#
# ── IN BOTH FILES ──────────────────────────────────────────────────────────────────────────────
# Nine variables appear in this file AND in ../infrastructure/.env.ci, because compose interpolates
# each file independently and Coolify enters variables per resource: PP_IMAGE_REGISTRY, PP_IMAGE_TAG,
# PP_NETWORK, PROCESSPUZZLE_DB_USERNAME, PROCESSPUZZLE_DB_PASSWORD, KC_INTERNAL_URL,
# PLATFORM_ADMIN_CLIENT_SECRET, MINIO_SERVICE_USER and MINIO_SERVICE_PASSWORD. Change one here and
# it has to change there too.

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=latest

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
PP_TESTBED_FRONTEND_PUBLISH=9090:80
PP_TESTBED_BACKEND_PUBLISH=8080:8080

# ── Frontend ────────────────────────────────────────────────────────────────────────────────────
# Selects run-time-conf/config.ci.json out of the bundle the frontend image baked.
PIPELINE_STAGE=ci
# Empty, and no longer load-bearing. It used to need a non-empty placeholder because the frontend's
# entrypoint `:?`-guarded it and the container exited without one; Firebase was removed in
# 1465575b / 7076cae2 and the guard went with it. Listed only so the variable stays visible next to
# PIPELINE_STAGE, which is the other value the entrypoint templates.
FIREBASE_API_KEY=

# ── Backend ─────────────────────────────────────────────────────────────────────────────────────
# The stack's own database, realm and bucket prefix — one string, mechanically derived, see
# docs/application-stacks.md.
SPRING_PROFILES_ACTIVE=ci
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processpuzzle_testbed
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PROCESSPUZZLE_DB_PASSWORD=processpuzzle
PROCESSPUZZLE_SECURITY_STACK_REALM=processpuzzle-testbed
MINIO_BUCKET_PREFIX=processpuzzle-testbed
MINIO_ENDPOINT=http://minio:9000
MINIO_SERVICE_USER=springboot
MINIO_SERVICE_PASSWORD=springboot123
KC_INTERNAL_URL=http://keycloak:8080
PLATFORM_ADMIN_CLIENT_SECRET=platform-admin-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:9090,http://localhost:4200
# Both URLs, because here they genuinely differ — see the comment on the service.
PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL=http://localhost:7070
PROCESSPUZZLE_SECURITY_JWKS_BASE_URL=http://keycloak:8080
