# ── testbed · prod ──────────────────────────────────────────────────────────────────────────────
#
# The processpuzzle-testbed application stack — its frontend and its backend — in production. One
# Coolify Docker Compose resource reads docker-compose-apps.yaml, and this is its environment. See
# .env.stage in this directory for what each variable does and why; only the values differ.
#
# NON-SECRET values only. The three credentials this resource needs — PROCESSPUZZLE_DB_PASSWORD,
# MINIO_SERVICE_PASSWORD and PLATFORM_ADMIN_CLIENT_SECRET — come from the GitHub Environment `PROD`.
#
# ONE FILE, ONE RESOURCE. Nine variables appear in this file AND in ../infrastructure/.env.prod:
# PP_IMAGE_REGISTRY, PP_IMAGE_TAG, PP_NETWORK, PROCESSPUZZLE_DB_USERNAME, PROCESSPUZZLE_DB_PASSWORD,
# KC_INTERNAL_URL, PLATFORM_ADMIN_CLIENT_SECRET, MINIO_SERVICE_USER and MINIO_SERVICE_PASSWORD.
# Change one here and it has to change there too.
#
# ⚠ THE HOSTNAMES BELOW ARE UNVERIFIED AND DISAGREE WITH STAGE — see the header of
# ../infrastructure/.env.prod for the five places that have to change together.

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=prod

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
PP_NETWORK=processpuzzle-prod

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# Both loopback-bound, since Coolify's proxy reaches the containers over the compose network. The
# backend is on 8180 rather than 8080 because `coolify-proxy` owns 0.0.0.0:8080 — see .env.stage.
PP_TESTBED_FRONTEND_PUBLISH=127.0.0.1:9090:80
PP_TESTBED_BACKEND_PUBLISH=127.0.0.1:8180:8080

# ── Frontend ────────────────────────────────────────────────────────────────────────────────────
PIPELINE_STAGE=prod
FIREBASE_API_KEY=

# ── Backend ─────────────────────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processpuzzle_testbed
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PROCESSPUZZLE_SECURITY_STACK_REALM=processpuzzle-testbed
MINIO_BUCKET_PREFIX=processpuzzle-testbed
MINIO_ENDPOINT=http://minio:9000
MINIO_SERVICE_USER=springboot
KC_INTERNAL_URL=http://keycloak:8080
# The origin presigned URLs name, followed by the BROWSER and not by the backend — so a
# public hostname, unlike every other MinIO setting here. See docker-compose-apps.yaml.
MINIO_PUBLIC_ENDPOINT=https://minio.processpuzzle.com

# ── The two that cannot take a CI default ───────────────────────────────────────────────────────
# An origin missing from the CORS list arrives at the browser as HTTP status 0, and an issuer that
# differs from KC_HOSTNAME by one character rejects every token. Both carry the unverified-hostname
# caveat in this file's header.
APP_CORS_ALLOWED_ORIGINS=https://testbed.processpuzzle.com
PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL=https://auth.processpuzzle.com
