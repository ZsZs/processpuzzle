# ── testbed · stage ─────────────────────────────────────────────────────────────────────────────
#
# The processpuzzle-testbed application stack — its frontend and its backend — in the stage
# environment. One Coolify Docker Compose resource reads docker-compose-apps.yaml, and this is its
# environment.
#
# NON-SECRET values only. The three credentials this resource needs — PROCESSPUZZLE_DB_PASSWORD,
# MINIO_SERVICE_PASSWORD and PLATFORM_ADMIN_CLIENT_SECRET — come from the GitHub Environment `STAGE`
# (see .env.example) and have to be entered into the Coolify resource marked as secret.
#
# HOW THIS FILE REACHES THE DEPLOYMENT. A Coolify Docker Compose resource reads the compose file from
# git and interpolates it with the RESOURCE'S OWN environment variables — `--env-file` is not in that
# path. So this file is the documented source of truth that has to be entered once into the Coolify
# application resource. `--env-file` is what `ci` and local development use. Because every variable
# in the compose file carries a `${VAR:-<ci default>}` default, a variable missed in Coolify degrades
# to the CI value rather than to an empty string — check the rendered `docker compose config` on the
# first deploy.
#
# ONE FILE, ONE RESOURCE. This file serves docker-compose-apps.yaml alone; the infrastructure
# resource reads ../infrastructure/.env.stage. Nine variables appear in BOTH, because compose
# interpolates each file independently and Coolify enters variables per resource: PP_IMAGE_REGISTRY,
# PP_IMAGE_TAG, PP_NETWORK, PROCESSPUZZLE_DB_USERNAME, PROCESSPUZZLE_DB_PASSWORD, KC_INTERNAL_URL,
# PLATFORM_ADMIN_CLIENT_SECRET, MINIO_SERVICE_USER and MINIO_SERVICE_PASSWORD. Change one here and
# it has to change there too. Combined runs pass both files; repeated `--env-file` is additive.
#
# HOSTNAMES ARE `.de`, matching the Coolify control plane — see ../infrastructure/.env.stage.

# ── Images ──────────────────────────────────────────────────────────────────────────────────────
# The moving tag the resource watches; deploy-testbed-apps.yml pushes it.
PP_IMAGE_REGISTRY=ghcr.io/zszs
PP_IMAGE_TAG=stage

# ── Network ─────────────────────────────────────────────────────────────────────────────────────
# Joined as `external`: the infrastructure resource creates it.
PP_NETWORK=processpuzzle-stage

# ── Published ports (host:container) ────────────────────────────────────────────────────────────
# Loopback-bound like the infrastructure ones: Coolify's proxy reaches both containers over the
# compose network, so neither needs a public bind, and an SSH tunnel still reaches them for
# inspection.
#
# The BACKEND cannot take host 8080: `coolify-proxy` (Traefik) publishes 0.0.0.0:8080 for its own
# dashboard on every Coolify host, so a bind there fails with "port is already allocated" — and a
# 127.0.0.1 bind fails too, because the wildcard already covers it. 8180 is the inspection port
# instead. Nothing else needs changing: Coolify's proxy routes api.stage.processpuzzle.de to
# testbed-backend:8080 over the compose network, so the host publish is for tunnelling only.
PP_TESTBED_FRONTEND_PUBLISH=127.0.0.1:9090:80
PP_TESTBED_BACKEND_PUBLISH=127.0.0.1:8180:8080

# ── Frontend ────────────────────────────────────────────────────────────────────────────────────
# Selects run-time-conf/config.stage.json out of the bundle the frontend image baked, and the
# `on-profile: stage | prod` block of the backend's application.yaml. Everything else about the two
# images is environment-neutral, which is what lets one `sha-<commit>` be promoted (strategy §9).
PIPELINE_STAGE=stage
FIREBASE_API_KEY=

# ── Backend ─────────────────────────────────────────────────────────────────────────────────────
# The testbed stack's own database, realm and bucket prefix — one string, mechanically derived, see
# docs/application-stacks.md. PostgreSQL, MinIO and Keycloak's admin API are all reached over the
# compose network, so these are service names and not the loopback-published ports.
SPRING_PROFILES_ACTIVE=stage
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processpuzzle_testbed
PROCESSPUZZLE_DB_USERNAME=processpuzzle
PROCESSPUZZLE_SECURITY_STACK_REALM=processpuzzle-testbed
MINIO_BUCKET_PREFIX=processpuzzle-testbed
MINIO_ENDPOINT=http://minio:9000
MINIO_SERVICE_USER=springboot
KC_INTERNAL_URL=http://keycloak:8080
# The origin presigned URLs name, followed by the BROWSER and not by the backend — so a
# public hostname, unlike every other MinIO setting here. See docker-compose-apps.yaml.
MINIO_PUBLIC_ENDPOINT=https://minio.stage.processpuzzle.de

# ── The two that CANNOT take a CI default ───────────────────────────────────────────────────────
# Every other variable in docker-compose-apps.yaml degrades safely to its CI value. These two do
# not, and both fail silently:
#
# - CORS is load-bearing here because nginx does NOT proxy to the backend. The browser calls
#   BACKEND_SERVICE_ROOT (api.stage…) from the frontend's origin (testbed.stage…), cross-origin, so
#   an origin missing from this list arrives as HTTP status 0 with no explanation. Left at the CI
#   default it would allow localhost and nothing else.
# - The issuer must equal KC_HOSTNAME in ../infrastructure/.env.stage. Left at the CI default
#   (http://localhost:7070) the backend rejects every token the real Keycloak minted.
#
# JWKS stays on the compose network and therefore keeps its CI default: the browser-facing origin
# does not resolve inside the container, and reading the signing keys from the issuer URL is what
# made every authenticated request answer 500 — see TenantAuthenticationManagerResolver.
APP_CORS_ALLOWED_ORIGINS=https://testbed.stage.processpuzzle.de
PROCESSPUZZLE_SECURITY_ISSUER_BASE_URL=https://auth.stage.processpuzzle.de
