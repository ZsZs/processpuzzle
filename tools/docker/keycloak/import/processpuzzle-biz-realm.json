{
  "realm": "processpuzzle-biz",
  "displayName": "ProcessPuzzle Biz",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' http://localhost:9092; object-src 'none';",
    "xFrameOptions": ""
  },
  "clients": [
    {
      "clientId": "processpuzzle-biz",
      "name": "ProcessPuzzle Biz",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:9092",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:9092/*"
      ],
      "webOrigins": [
        "http://localhost:9092"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:9092/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ]
}
