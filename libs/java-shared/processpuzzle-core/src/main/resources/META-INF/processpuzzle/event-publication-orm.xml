<?xml version="1.0" encoding="UTF-8"?>
<!--
  Column types for the Spring Modulith event publication registry (spring-modulith-events-jpa).
  Its entities declare plain @Column fields with no length, so Hibernate maps them as varchar(255) - and a
  serialized PlatformEvent carries the entity's whole payload. An event that does not fit fails the INSERT, and
  because the publication is written inside the publishing transaction, the business write fails with it:
  creating an Order answered 500 on 2026-10-08 (testbed), saving an invoice on 2026-10-13 (custom backend).
  Modulith ships schema scripts for its JDBC variant only; with JPA the schema is the application's to declare.

  Here, in processpuzzle-core, for every backend that has the registry: registered by
  com.processpuzzle.core.persistence.EventPublicationMappingAutoConfiguration, so no application needs a
  META-INF/orm.xml of its own. Hibernate 7's schema update aligns a plainly mapped column with its mapping on
  every start, which narrowed a column widened by hand back to varchar(255); a column with an explicit definition
  it leaves alone. So a new database gets text here, and a widened column stays text - but a column a database
  already holds narrow is not widened by this mapping, and is altered once by hand.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

  <entity class="org.springframework.modulith.events.jpa.updating.DefaultJpaEventPublication">
    <attribute-override name="serializedEvent">
      <column name="serialized_event" column-definition="text"/>
    </attribute-override>
    <attribute-override name="listenerId">
      <column name="listener_id" column-definition="text"/>
    </attribute-override>
    <attribute-override name="eventType">
      <column name="event_type" column-definition="text"/>
    </attribute-override>
  </entity>

  <entity class="org.springframework.modulith.events.jpa.archiving.ArchivedJpaEventPublication">
    <attribute-override name="serializedEvent">
      <column name="serialized_event" column-definition="text"/>
    </attribute-override>
    <attribute-override name="listenerId">
      <column name="listener_id" column-definition="text"/>
    </attribute-override>
    <attribute-override name="eventType">
      <column name="event_type" column-definition="text"/>
    </attribute-override>
  </entity>
</entity-mappings>
