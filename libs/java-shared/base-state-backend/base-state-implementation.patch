diff --git a/libs/java-shared/base-state-backend/src/main/java/com/processpuzzle/basestate/usecase/port/TransitionAction.java b/libs/java-shared/base-state-backend/src/main/java/com/processpuzzle/basestate/usecase/port/TransitionAction.java
