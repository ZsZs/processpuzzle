    "size": { "width": "120", "height": "80", "depth": "50", "unit": "cm" },
    "flat": { "width": "2", "height": "3", "unit": "m" }
  },
  "rates": [
    { "from": "EUR", "to": "USD", "rate": "1.10", "validFrom": "2026-01-01" },
    { "from": "EUR", "to": "USD", "rate": "1.20", "validFrom": "2026-07-01" }
  ],
  "cases": [
