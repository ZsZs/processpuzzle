    { "expression": "qty(entity.weight).gt(qty('5 kg'))", "expected": true },
    { "expression": "qty(entity.weight).lt(qty('5 kg'))", "expected": false },
    { "expression": "qty(entity.weight).ge(qty('6 kg')) && qty(entity.weight).le(qty('6 kg'))", "expected": true },
    { "expression": "qty('10 kg').gt(qty('9 kg'))", "expected": true },
    { "expression": "qty('1 m').to('ft').amount === '3.28083989501312335958'", "expected": true },
    { "expression": "qty('25 degC').to('degF').amount === '77'", "expected": true },
    { "expression": "qty('10 kg').times(3).dividedBy(2).eq(qty('15 kg'))", "expected": true },
    { "expression": "qty('1 kg').plus('500 g').eq(qty('1.5 kg'))", "expected": true },
    { "expression": "qty('1 kg').minus(qty('250 g')).amount === '0.75'", "expected": true },
    { "expression": "qty('5 kg').base === 5", "expected": true },
    { "expression": "qty('5.50 kg').amount === '5.5' && qty('5.50 kg').unit === 'kg'", "expected": true },
    { "expression": "qty({ amount: 5, unit: 'kg' }).eq(qty('5000 g'))", "expected": true },
