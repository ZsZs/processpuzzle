    { "expression": "money('19.99 EUR').times('0.27').amount === '5.3973'", "expected": true },
    { "expression": "money('19.99 EUR').times(0.27).round().amount === '5.4'", "expected": true },
    { "expression": "money('10 EUR').plus(money('0.5 EUR')).eq(money('10.50 EUR'))", "expected": true },
    { "expression": "money('10 EUR').dividedBy(3).round().amount === '3.33'", "expected": true },
    { "expression": "money('2.5 JPY').round().amount === '3'", "expected": true },
    { "expression": "dims(entity.size).volume().lt(qty('0.5 m3'))", "expected": true },
    { "expression": "dims(entity.size).area().eq(qty('0.96 m2'))", "expected": true },
    { "expression": "dims(entity.size).to('m').width === '1.2' && dims(entity.size).depth === '50'", "expected": true },
    { "expression": "dims(entity.flat).depth == null && dims(entity.flat).area().eq(qty('6 m2'))", "expected": true },
    { "expression": "typeof qty('5 kg') === 'object' && typeof money('1 EUR') === 'object'", "expected": true },
    { "expression": "money('10 EUR').minus(money('0.5 EUR')).amount === '9.5' && money('10 EUR').currency === 'EUR'", "expected": true },
    { "expression": "money('5 EUR').lt(money('6 EUR')) && money('6 EUR').ge(money('6 EUR')) && money('6 EUR').eq(money('6.00 EUR'))", "expected": true },
    { "expression": "`${money('5.0 EUR')}` === '5 EUR' && `${dims(entity.size)}` === '120 x 80 x 50 cm'", "expected": true },
    { "expression": "dims(entity.size).height === '80' && dims(entity.size).unit === 'cm'", "expected": true },
