{
  "name": "processpuzzle-testbed-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/processpuzzle-testbed-frontend/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/processpuzzle-testbed-frontend",
        "index": "apps/processpuzzle-testbed-frontend/src/index.html",
        "browser": "apps/processpuzzle-testbed-frontend/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/processpuzzle-testbed-frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/processpuzzle-testbed-frontend/public"
          },
          {
            "glob": "**/*",
            "input": "apps/processpuzzle-testbed-frontend/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/auth/feature/assets/auth",
            "output": "assets/auth"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/auth/feature/assets/i18n/auth",
            "output": "assets/i18n/auth"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-app-frontend/src/assets/i18n/base_app",
            "output": "assets/i18n/base_app"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-document-frontend/src/assets/i18n/base_document",
            "output": "assets/i18n/base_document"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-entity-frontend/src/assets/i18n/base_entity",
            "output": "assets/i18n/base_entity"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-state-frontend/src/assets/i18n/base_state",
            "output": "assets/i18n/base_state"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-workflow-frontend/src/assets/i18n/base_workflow",
            "output": "assets/i18n/base_workflow"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-workflow-frontend/src/assets/modeler",
            "output": "assets/modeler"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/design/src/assets/i18n/design",
            "output": "assets/i18n/design"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-widget-frontend/src/assets/i18n/widgets",
            "output": "assets/i18n/widgets"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-widget-frontend/src/assets/i18n/base_widget",
            "output": "assets/i18n/base_widget"
          },
          "apps/processpuzzle-testbed-frontend/src/environments",
          "apps/processpuzzle-testbed-frontend/src/run-time-conf"
        ],
        "styles": [
          "libs/js-shared/base-widget-frontend/src/theme/pp-colors.css",
          "apps/processpuzzle-testbed-frontend/src/custom-theme.scss",
          "libs/js-shared/base-app-frontend/src/theme/pp-material-themes.scss",
          "apps/processpuzzle-testbed-frontend/src/styles.scss",
          "node_modules/prismjs/themes/prism-okaidia.css",
          "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.css",
          "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.css",
          "node_modules/prismjs/plugins/command-line/prism-command-line.css"
        ],
        "scripts": [
          "node_modules/clipboard/dist/clipboard.min.js",
          "node_modules/mermaid/dist/mermaid.min.js",
          "node_modules/prismjs/prism.js",
          "node_modules/prismjs/components/prism-csharp.min.js",
          "node_modules/prismjs/components/prism-css.min.js",
          "node_modules/prismjs/components/prism-typescript.min.js",
          "node_modules/prismjs/components/prism-javascript.min.js",
          "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.js",
          "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.js",
          "node_modules/prismjs/plugins/command-line/prism-command-line.js"
        ],
        "allowedCommonJsDependencies": ["prismjs", "build-url-ts", "reflect-metadata"]
      },
      "configurations": {
        "production": {
          "baseHref": "/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "6mb",
              "maximumError": "8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "24kb",
              "maximumError": "32kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": {
            "scripts": true,
            "styles": true,
            "hidden": false,
            "vendor": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/processpuzzle-testbed-frontend/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "processpuzzle-testbed-frontend:build:production"
        },
        "development": {
          "buildTarget": "processpuzzle-testbed-frontend:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "processpuzzle-testbed-frontend:build"
      }
    },
    "lint": {
      "configurations": {
        "ci": {
          "format": "../../tools/eslint/console-and-json.formatter.mjs"
        },
        "dev": {
          "format": "html",
          "output-file": "reports/eslint/eslint.html"
        }
      },
      "outputs": ["{projectRoot}/reports/eslint/eslint.json", "{projectRoot}/reports/eslint/eslint.html", "{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{projectRoot}/reports/coverage"],
      "dependsOn": ["^build"],
      "options": {
        "runner": "vitest",
        "runnerConfig": "apps/processpuzzle-testbed-frontend/vitest.config.ts",
        "tsConfig": "apps/processpuzzle-testbed-frontend/tsconfig.spec.json",
        "coverage": true
      },
      "configurations": {
        "ci": {
          "coverage": true,
          "coverageReporters": ["lcov", "json-summary"]
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "processpuzzle-testbed-frontend:build",
        "port": 4200,
        "staticFilePath": "dist/apps/processpuzzle-testbed-frontend/browser",
        "spa": true
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{workspaceRoot}/dist/apps/processpuzzle-testbed-frontend"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment patch"
      },
      "configurations": {
        "major": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment major"
        },
        "minor": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment minor"
        },
        "patch": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment patch"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "processpuzzle-testbed-backend:build"],
      "options": {
        "command": "docker compose -f tools/docker/docker-compose-ci.yaml build"
      }
    }
  }
}
