<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.processpuzzle</groupId>
        <artifactId>processpuzzle-parent</artifactId>
        <version>1.0.5-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>processpuzzle-testbed-backend</artifactId>
    <name>ProcessPuzzle :: Testbed Backend Application</name>
    <description>ProcessPuzzle Testbed Backend Application</description>

    <dependencies>
        <!-- Module dependencies -->
        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>processpuzzle-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>processpuzzle-store</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-rule-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-app-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-document-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-entity-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-state-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-workflow-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>base-widget-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>com.processpuzzle</groupId>
            <artifactId>org-admin-backend</artifactId>
        </dependency>

        <!--
            The resource server. Realm-per-tenant means one issuer per organization, which is what
            JwtIssuerAuthenticationManagerResolver exists for — see SecurityConfig.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Modulith: this application is the Modulith root, so it is where the module
             structure is computed at runtime and exposed at /actuator/modulith. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- The runtime datasource for every deployment. One PostgreSQL database per application
             stack, created by tools/docker/postgresql/init-db.sql - see docs/application-stacks.md. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 is for tests only, and the scope is what enforces that: every application-unit-test.yaml
             pins its own H2 URL and the H2Dialect, so a test never touches a running PostgreSQL, and a
             deployment can never fall back to an in-memory database because the driver happened to be
             on the classpath. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Copy the repackaged Spring Boot jar to the Nx dist directory on `mvn install` -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-jar-to-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${project.basedir}/../../dist/apps/${project.artifactId}/${project.artifactId}.jar"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
