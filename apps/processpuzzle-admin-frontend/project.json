{
  "name": "processpuzzle-admin-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/processpuzzle-admin-frontend/src",
  "tags": ["type:app"],
  "implicitDependencies": ["platform-admin-frontend"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/processpuzzle-admin-frontend",
        "index": "apps/processpuzzle-admin-frontend/src/index.html",
        "browser": "apps/processpuzzle-admin-frontend/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/processpuzzle-admin-frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/processpuzzle-admin-frontend/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/auth/feature/assets/auth",
            "output": "assets/auth"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/auth/feature/assets/i18n/auth",
            "output": "assets/i18n/auth"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-entity-frontend/src/assets/i18n/base_entity",
            "output": "assets/i18n/base_entity"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-widget-frontend/src/assets/i18n/widgets",
            "output": "assets/i18n/widgets"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/base-widget-frontend/src/assets/i18n/base_widget",
            "output": "assets/i18n/base_widget"
          },
          {
            "glob": "**/*",
            "input": "libs/js-shared/platform-admin-frontend/src/assets/i18n/platform_admin",
            "output": "assets/i18n/platform_admin"
          },
          "apps/processpuzzle-admin-frontend/src/run-time-conf"
        ],
        "styles": [
          "libs/js-shared/base-widget-frontend/src/theme/pp-colors.css",
          "apps/processpuzzle-admin-frontend/src/custom-theme.scss",
          "apps/processpuzzle-admin-frontend/src/styles.scss"
        ],
        "allowedCommonJsDependencies": ["build-url-ts", "reflect-metadata"]
      },
      "configurations": {
        "production": {
          "baseHref": "/",
          "fileReplacements": [
            {
              "replace": "apps/processpuzzle-admin-frontend/src/environments/environment.ts",
              "with": "apps/processpuzzle-admin-frontend/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "24kb",
              "maximumError": "32kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": {
            "scripts": true,
            "styles": true,
            "hidden": false,
            "vendor": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/processpuzzle-admin-frontend/proxy.conf.json",
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "processpuzzle-admin-frontend:build:production"
        },
        "development": {
          "buildTarget": "processpuzzle-admin-frontend:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "processpuzzle-admin-frontend:build"
      }
    },
    "lint": {
      "configurations": {
        "ci": {
          "format": "../../tools/eslint/console-and-json.formatter.mjs"
        },
        "dev": {
          "format": "html",
          "output-file": "reports/eslint/eslint.html"
        }
      },
      "outputs": ["{projectRoot}/reports/eslint/eslint.json", "{projectRoot}/reports/eslint/eslint.html", "{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{projectRoot}/reports/coverage"],
      "dependsOn": ["^build"],
      "options": {
        "runner": "vitest",
        "runnerConfig": "apps/processpuzzle-admin-frontend/vitest.config.ts",
        "tsConfig": "apps/processpuzzle-admin-frontend/tsconfig.spec.json",
        "coverage": true
      },
      "configurations": {
        "ci": {
          "coverage": true,
          "coverageReporters": ["lcov", "json-summary"]
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "processpuzzle-admin-frontend:build",
        "port": 4201,
        "staticFilePath": "dist/apps/processpuzzle-admin-frontend/browser",
        "spa": true
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{workspaceRoot}/dist/apps/processpuzzle-admin-frontend"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment patch"
      },
      "configurations": {
        "major": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment major"
        },
        "minor": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment minor"
        },
        "patch": {
          "command": "node tools/scripts/release-js-lib.mjs prepare --project {projectName} --increment patch"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "processpuzzle-testbed-backend:build"],
      "options": {
        "command": "docker compose -f tools/docker/docker-compose-ci.yaml build processpuzzle-admin-frontend"
      }
    }
  }
}
